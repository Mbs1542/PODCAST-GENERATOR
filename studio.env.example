# Copy to studio.env (it is git-ignored) to open M.B.S Studio from other devices.
# API keys are NOT set here: enter them in the app's settings screen; they are saved in studio-data/.env.

# The addresses or names you will type in the browser, comma separated (VPN address, LAN name, domain)
MBS_ALLOWED_HOSTS=10.8.0.1

# Password for the sign-in screen, at least 12 characters. Required whenever MBS_ALLOWED_HOSTS is set,
# unless a reverse proxy checks a Cloudflare Access login in front of the app (then set the next line instead).
MBS_ACCESS_KEY=
# MBS_EXTERNAL_AUTH=cloudflare-access

# Transcription on the Mac's GPU (Docker Desktop on Apple Silicon): run the worker natively,
#   python -m src.transcribe.gpu_worker --token-file <file>   (pip install -r requirements-mac-gpu.txt)
# and point the container at it. Without these two, transcription runs on the CPU as before.
# MBS_GPU_URL=http://host.docker.internal:8766
# MBS_GPU_TOKEN=
