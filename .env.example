# Copy to .env and fill in. Run `python -m scripts.doctor` to see what is configured.

# --- Script writing (required) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-01

# --- Voices: fill in at least one ---
# Azure Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# ElevenLabs: both hosts rendered together (Text to Dialogue). Pick voices in the app (Settings > Load voices)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ROEE=
ELEVENLABS_VOICE_NOA=
# eleven_v4 (recommended) or eleven_v3; older models have no Hebrew
ELEVENLABS_MODEL=eleven_v4
# Gemini multi-speaker voices use GEMINI_API_KEY below
GEMINI_VOICE_ROEE=Charon
GEMINI_VOICE_NOA=Aoede
# auto, elevenlabs, gemini, azure. auto = the provider that has keys (Gemini only if nothing else has)
DEFAULT_TTS_PROVIDER=auto

# --- Optional ---
GEMINI_API_KEY=

# --- Script engine v2 ---
# v2 = staged engine (default), legacy = the old single-prompt generator
DIALOGUE_ENGINE=v2
# The podcast's language: he (default) or en. Independent of the lecture's language
PODCAST_LANGUAGE=he
# auto, deep_dive, beginner_explainer, exam_prep, story, debate
PODCAST_FORMAT=auto
# 0 = automatic (about 30% of the lecture, 6-30 minutes)
PODCAST_TARGET_MINUTES=0
# How many times a segment that fails checks is rewritten
SCRIPT_MAX_REVISIONS=1
# Fact-check each segment against the transcript
VERIFY_GROUNDING=true

# --- Local checker model (Ollama), used for cleanup and fact-checking ---
# auto = use it when Ollama is running and has the model, on = require it, off = never
LOCAL_LLM=auto
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=gemma3:12b
# Context window in tokens; 12288 fits gemma3:12b on a 12 GB GPU
LOCAL_LLM_CONTEXT=12288
